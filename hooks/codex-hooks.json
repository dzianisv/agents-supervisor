{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/codex-supervisor-hook.mjs\"", "timeout": 10 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/codex-supervisor-hook.mjs\"", "timeout": 120, "async": true }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/codex-supervisor-hook.mjs\"", "timeout": 10 }] }
    ]
  }
}

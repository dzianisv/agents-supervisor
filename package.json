{
  "name": "agents-supervisor",
  "version": "0.1.0",
  "description": "Supervisor for Claude Code and OpenCode; includes an opt-in Codex observer that reviews recent tool activity and offers targeted corrections.",
  "type": "module",
  "license": "MIT",
  "author": "dzianisv",
  "repository": {
    "type": "git",
    "url": "https://github.com/dzianisv/agents-supervisor"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-force-exit \"test/!(e2e-*).test.mjs\"",
    "test:e2e": "node --experimental-strip-types --test test/e2e-opencode.test.mjs",
    "test:e2e:codex": "node --experimental-strip-types --test test/e2e-codex.test.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "test:cc": "node test/e2e-cc.mjs",
    "test:smoke": "node test/smoke-cc.mjs",
    "eval": "node evals/judge-eval.mjs",
    "eval:plainspeak": "node evals/plainspeak-eval.mjs",
    "train": "node train/run-train.mjs"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^0.5.0"
  }
}
